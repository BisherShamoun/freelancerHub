# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/freelance_hub"

# Redis (used by cache-manager and BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="replace-with-a-long-random-access-token-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
  FREELANCER
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  HOLD
  PAYOUT
  COMMISSION
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  password     String
  role         Role     @default(CLIENT)
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet            Wallet?
  freelancerProfile FreelancerProfile?
  projects          Project[]  @relation("ProjectClient")
  proposals         Proposal[] @relation("ProposalFreelancer")

  // @@index([role, createdAt])
  // @@map("users")
}

model FreelancerProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  bio        String?  @db.Text
  hourlyRate Decimal  @default(0) @db.Decimal(10, 2)
  avatarUrl  String?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // @@map("freelancer_profiles")
}

model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  availableBalance Decimal  @default(0) @db.Decimal(12, 2)
  heldBalance      Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  // @@map("wallets")
}

model WalletTransaction {
  id           String          @id @default(uuid()) @db.Uuid
  walletId     String          @db.Uuid
  projectId    String?         @db.Uuid
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())

  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // @@index([walletId, createdAt])
  // @@index([projectId])
  // @@map("wallet_transactions")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  projects Project[]

  // @@map("categories")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  clientId       String        @db.Uuid
  categoryId     String        @db.Uuid
  title          String
  description    String        @db.Text
  budget         Decimal       @db.Decimal(12, 2)
  status         ProjectStatus @default(OPEN)
  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client       User                @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Restrict)
  category     Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  proposals    Proposal[]
  delivery     Delivery?
  transactions WalletTransaction[]

  // @@index([status, categoryId, createdAt])
  // @@index([status, budget])
  // @@index([clientId, createdAt])
  // @@map("projects")
}

model Proposal {
  id           String         @id @default(uuid()) @db.Uuid
  projectId    String         @db.Uuid
  freelancerId String         @db.Uuid
  price        Decimal        @db.Decimal(12, 2)
  durationDays Int
  message      String         @db.Text
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer User    @relation("ProposalFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)

  @@unique([projectId, freelancerId])
  // @@index([projectId, status])
  // @@index([freelancerId, createdAt])
  // @@map("proposals")
}

model Delivery {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @unique @db.Uuid
  filePath   String
  fileName   String
  sizeBytes  Int
  uploadedAt DateTime  @default(now())
  approvedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // @@map("deliveries")
}
